# Préparation des données
result_1st_imp$Condition <- "Condition 1"
result_1st_imp_2$Condition <- "Condition 2"

result_combined <- bind_rows(result_1st_imp, result_1st_imp_2) %>%
  mutate(
    Type = factor(Type, levels = c("Patient", "Healthy")),
    Condition = factor(Condition, levels = c("Condition 1", "Condition 2")),
    Group = case_when(
      Type == "Patient" & Condition == "Condition 1" ~ "ISZ",
      Type == "Healthy" & Condition == "Condition 1" ~ "HC",
      Type == "Patient" & Condition == "Condition 2" ~ "ISZ - TINE",
      Type == "Healthy" & Condition == "Condition 2" ~ "HC - bonne santé"
    )
  )

result_combined$Group <- factor(
  result_combined$Group,
  levels = c("ISZ", "HC", "ISZ - TINE", "HC - bonne santé")
)

# ANOVA
anova_model <- aov(Total_score ~ Type * Condition, data = result_combined)
summary(anova_model)

# emmeans sur les variables du modèle
emm <- emmeans(anova_model, ~ Type * Condition)

# Contrastes ciblés
contrast_results <- contrast(
  emm,
  method = list(
    "Cond1: ISZ vs HC" = c(1, -1, 0, 0),
    "Cond2: ISZ vs HC" = c(0, 0, 1, -1),
    "ISZ: Cond1 vs Cond2" = c(1, 0, -1, 0),
    "HC: Cond1 vs Cond2" = c(0, 1, 0, -1)
  ),
  adjust = "bonferroni"
)

contrast_df <- as.data.frame(summary(contrast_results))

# Ajouter les groupes pour le plot
contrast_df$group1 <- c("ISZ", "ISZ - TINE", "ISZ", "HC")
contrast_df$group2 <- c("HC", "HC - bonne santé", "ISZ - TINE", "HC - bonne santé")
contrast_df$y.position <- c(620, 660, 700, 740)

# Transformer p-values en étoiles
contrast_df$p.signif <- ifelse(
  contrast_df$p.value <= 0.001, "***",
  ifelse(
    contrast_df$p.value <= 0.01, "**",
    ifelse(
      contrast_df$p.value <= 0.05, "*", "ns"
    )
  )
)

# Plot
pcc <- ggplot(result_combined, aes(x = Group, y = Total_score, fill = Group)) +
  stat_summary(fun = mean, geom = "bar", width = 0.6) +
  stat_summary(fun.data = mean_cl_boot, geom = "errorbar", width = 0.2) +
  stat_pvalue_manual(
    contrast_df,
    label = "p.signif",
    tip.length = 0.01,
    hide.ns = TRUE
  ) +
  theme_minimal() +
  theme(
    legend.position = "none",
    axis.title.x = element_text(margin = margin(t = 8)),
