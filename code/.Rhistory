install.packages("glmmLasso")
library(tidyverse)
library(lme4)
library(lmerTest)
library(glmmLasso)
library(performance)
library(broom.mixed)
library(gt)
features_to_test <- c(
# QoM
"hands_total_qom", "hands_horizontal_qom", "hands_vertical_qom",
"head_total_qom",  "head_horizontal_qom",  "head_vertical_qom",
# Expansiveness
"hands_total_expansiveness", "hands_horizontal_expansiveness", "hands_vertical_expansiveness",
"head_total_expansiveness",  "head_horizontal_expansiveness",  "head_vertical_expansiveness",
# Expansiveness per extremum
"hands_total_expansiveness_per_extremum",
"hands_horizontal_expansiveness_per_extremum",
"hands_vertical_expansiveness_per_extremum",
"head_total_expansiveness_per_extremum",
"head_horizontal_expansiveness_per_extremum",
"head_vertical_expansiveness_per_extremum"
)
data_model <- data_full %>%
select(Total_score, CASE, participant_id, all_of(features_to_test)) %>%
drop_na() %>%
mutate(
CASE = as.factor(CASE),
participant_id = as.factor(participant_id),
Total_score_z = as.numeric(scale(Total_score)),
across(
all_of(features_to_test),
~ as.numeric(scale(.x)),
.names = "{.col}_z"
)
)
features_z <- paste0(features_to_test, "_z")
cat("Nombre d'évaluations :", nrow(data_model), "\n")
cat("Nombre d'observateurs CASE :", n_distinct(data_model$CASE), "\n")
cat("Nombre de targets participant_id :", n_distinct(data_model$participant_id), "\n")
check_target_level <- data_model %>%
group_by(participant_id) %>%
summarise(
across(
all_of(features_z),
~ n_distinct(.x),
.names = "n_distinct_{.col}"
),
.groups = "drop"
) %>%
pivot_longer(
cols = starts_with("n_distinct_"),
names_to = "feature",
values_to = "n_distinct_values"
) %>%
mutate(feature = str_remove(feature, "n_distinct_")) %>%
filter(n_distinct_values > 1)
if (nrow(check_target_level) == 0) {
cat("OK : les features sont constantes à l'intérieur de chaque target.\n")
} else {
print(check_target_level)
warning("Certaines features varient à l'intérieur d'une même target. À vérifier.")
}
full_formula <- as.formula(
paste(
"Total_score_z ~",
paste(features_z, collapse = " + "),
"+ (1 | CASE) + (1 | participant_id)"
)
)
m_full <- lmer(
full_formula,
data = data_model,
REML = FALSE,
control = lmerControl(
optimizer = "bobyqa",
optCtrl = list(maxfun = 2e5)
)
)
summary(m_full)
performance::check_collinearity(m_full)
performance::check_model(m_full)
fixed_formula_lasso <- as.formula(
paste(
"Total_score_z ~",
paste(features_z, collapse = " + ")
)
)
lambda_grid <- exp(seq(log(0.01), log(200), length.out = 60))
fit_glmm_lasso_safe <- function(lambda_value) {
tryCatch(
{
glmmLasso(
fix = fixed_formula_lasso,
rnd = list(
CASE = ~ 1,
participant_id = ~ 1
),
data = data_model,
lambda = lambda_value,
family = gaussian(link = "identity"),
final.re = FALSE,
control = list(
method = "REML",
center = FALSE,
standardize = FALSE,
print.iter = FALSE,
steps = 1000,
epsilon = 1e-4
)
)
},
error = function(e) {
message("Erreur pour lambda = ", lambda_value, " : ", e$message)
return(NULL)
}
)
}
lasso_models <- map(lambda_grid, fit_glmm_lasso_safe)
