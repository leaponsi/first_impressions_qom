library(readr)
library(dplyr)
library(car)
library(ggplot2)
stimuli_participants <- read_delim("stimuli_participants.csv",
delim = ";", escape_double = FALSE, trim_ws = TRUE, show_col_types = FALSE)
summary(stimuli_participants)
stimuli_participants %>%
group_by(Group) %>%
summarise(
mean = mean(diagnostic_duration, na.rm = TRUE),
sd = sd(diagnostic_duration, na.rm = TRUE)
)
stimuli_participants %>%
group_by(Group) %>%
summarise(
mean = mean(chlorpro_mg, na.rm = TRUE),
sd = sd(chlorpro_mg, na.rm = TRUE)
)
stimuli_participants$Group <- factor(stimuli_participants$Group)
stimuli_participants$Gender <- factor(stimuli_participants$Gender)
stimuli_participants$Age <- as.numeric(stimuli_participants$Age)
stimuli_participants$PANSS_Positive <- as.numeric(stimuli_participants$PANSS_Positive)
stimuli_participants$PANSS_Negative <- as.numeric(stimuli_participants$PANSS_Negative)
stimuli_participants$PANSS_Psychopathology <- as.numeric(stimuli_participants$PANSS_Psychopathology)
# Prerequisites for comparative analysis
check_and_test <- function(data, variable, group) {
formula <- as.formula(paste(variable, "~", group))
# Normalité par groupe
shapiro_results <- by(data[[variable]], data[[group]], shapiro.test)
shapiro_p <- sapply(shapiro_results, function(x) x$p.value)
# Homogénéité des variances
levene_result <- leveneTest(formula, data = data)
levene_p <- levene_result$`Pr(>F)`[1]
# Conditions
normality_ok <- all(shapiro_p >= 0.05)
homogeneity_ok <- levene_p >= 0.05
cat("\nVariable :", variable, "\n")
cat("----------------------------------\n")
cat("Normalité par groupe :\n")
print(round(shapiro_p, 4))
if (normality_ok) {
cat("→ Normalité respectée dans les deux groupes.\n")
} else {
cat("→ Normalité non respectée dans au moins un groupe.\n")
}
cat("\nHomogénéité des variances : p =", round(levene_p, 4), "\n")
if (homogeneity_ok) {
cat("→ Homogénéité des variances respectée.\n")
} else {
cat("→ Homogénéité des variances non respectée.\n")
}
cat("\nTest lancé :\n")
# Choix + lancement du test
if (normality_ok & homogeneity_ok) {
cat("→ t-test indépendant classique\n\n")
test_result <- t.test(formula, data = data, var.equal = TRUE)
} else if (normality_ok & !homogeneity_ok) {
cat("→ t-test de Welch\n\n")
test_result <- t.test(formula, data = data, var.equal = FALSE)
} else {
cat("→ Wilcoxon-Mann-Whitney\n\n")
test_result <- wilcox.test(formula, data = data)
}
print(test_result)
invisible(test_result)
}
to_check <- c("Age", "Education", "fNART_errors", "BDI_II", "MOCA")
for (var in to_check) {
check_and_test(stimuli_participants, var, "Group")
}
chi_square_test <- function(data, var1, var2) {
# Tableau de contingence
tab <- table(data[[var1]], data[[var2]])
cat("\nVariables :", var1, "x", var2, "\n")
cat("----------------------------------\n")
cat("Tableau de contingence :\n")
print(tab)
# Test du khi²
chi_result <- chisq.test(tab)
cat("\nEffectifs attendus :\n")
print(round(chi_result$expected, 2))
# Vérification des conditions
expected_ok <- all(chi_result$expected >= 5)
if (expected_ok) {
cat("\nConditions du khi² : respectées.\n")
cat("Test lancé : khi² d’indépendance.\n\n")
print(chi_result)
p_value <- chi_result$p.value
if (p_value < 0.05) {
cat("\nInterprétation :\n")
cat("→ Le test du khi² est significatif (p =", round(p_value, 4), ").\n")
cat("→ Il existe une différence significative entre les", var1, "concernant le", var2, ".\n")
} else {
cat("\nInterprétation :\n")
cat("→ Le test du khi² n’est pas significatif (p =", round(p_value, 4), ").\n")
cat("→ Il n'existe pas de différence significative entre les", var1, "concernant le", var2, ".\n")
}
invisible(chi_result)
} else {
cat("\nConditions du khi² : non respectées.\n")
cat("Au moins un effectif attendu est inférieur à 5.\n")
cat("Test lancé : test exact de Fisher.\n\n")
fisher_result <- fisher.test(tab)
print(fisher_result)
p_value <- fisher_result$p.value
if (p_value < 0.05) {
cat("\nInterprétation :\n")
cat("→ Le test exact de Fisher est significatif (p =", round(p_value, 4), ").\n")
cat("→ Il existe une différence significative entre les", var1, "concernant le", var2, ".\n")
} else {
cat("\nInterprétation :\n")
cat("→ Le test exact de Fisher n’est pas significatif (p =", round(p_value, 4), ").\n")
cat("→ Il n'existe pas de différence significative entre les", var1, "concernant le", var2, ".\n")
}
invisible(fisher_result)
}
}
chi_square_test(stimuli_participants, "Group", "Gender")
# voir la distribution des participants avec SZ concernant leur PANSS
ggplot(stimuli_participants, aes(y = P)) +
geom_boxplot() +
theme_minimal()
library(rempsyc)
library(dplyr)
library(tidyr)
library(effectsize)
# --- Helper qui produit une ligne de tableau pour une variable continue ---
build_row_continuous <- function(data, variable, group = "Group") {
formula <- as.formula(paste(variable, "~", group))
# Stats descriptives par groupe
desc <- data %>%
group_by(.data[[group]]) %>%
summarise(
m  = mean(.data[[variable]], na.rm = TRUE),
sd = sd(.data[[variable]],   na.rm = TRUE),
.groups = "drop"
)
# Choix du test (même logique que check_and_test)
shapiro_p <- sapply(by(data[[variable]], data[[group]], shapiro.test),
function(x) x$p.value)
levene_p  <- car::leveneTest(formula, data = data)$`Pr(>F)`[1]
normality_ok   <- all(shapiro_p >= 0.05)
homogeneity_ok <- levene_p >= 0.05
if (normality_ok & homogeneity_ok) {
test <- t.test(formula, data = data, var.equal = TRUE)
stat_label <- "t"
stat_val   <- unname(test$statistic)
df_val     <- unname(test$parameter)
es <- effectsize::cohens_d(formula, data = data, pooled_sd = TRUE)$Cohens_d
es_label <- "d"
} else if (normality_ok & !homogeneity_ok) {
test <- t.test(formula, data = data, var.equal = FALSE)
stat_label <- "t"
stat_val   <- unname(test$statistic)
df_val     <- unname(test$parameter)
es <- effectsize::cohens_d(formula, data = data, pooled_sd = FALSE)$Cohens_d
es_label <- "d"
} else {
test <- wilcox.test(formula, data = data)
stat_label <- "W"
stat_val   <- unname(test$statistic)
df_val     <- NA_real_
es <- effectsize::rank_biserial(formula, data = data)$r_rank_biserial
es_label <- "r"
}
data.frame(
Variable = variable,
G1_M_SD  = sprintf("%.2f (%.2f)", desc$m[1], desc$sd[1]),
G2_M_SD  = sprintf("%.2f (%.2f)", desc$m[2], desc$sd[2]),
Statistic = ifelse(is.na(df_val),
sprintf("%s = %.2f", stat_label, stat_val),
sprintf("%s(%.0f) = %.2f", stat_label, df_val, stat_val)),
p = test$p.value,
Effect_size = sprintf("%s = %.2f", es_label, es),
stringsAsFactors = FALSE
)
}
# --- Helper pour le Gender (qualitatif) ---
build_row_categorical <- function(data, variable, group = "Group") {
tab <- table(data[[group]], data[[variable]])
# n (%) pour le 1er niveau de la variable, par groupe
lvl <- colnames(tab)[1]
n_g1 <- tab[1, lvl]; n_g2 <- tab[2, lvl]
pct_g1 <- 100 * n_g1 / sum(tab[1, ])
pct_g2 <- 100 * n_g2 / sum(tab[2, ])
chi <- suppressWarnings(chisq.test(tab))
if (any(chi$expected < 5)) {
test <- fisher.test(tab)
stat_str <- "Fisher"
p_val <- test$p.value
} else {
test <- chi
stat_str <- sprintf("\u03C7\u00B2(%d) = %.2f", test$parameter, test$statistic)
p_val <- test$p.value
}
data.frame(
Variable = sprintf("%s (%% %s)", variable, lvl),
G1_M_SD  = sprintf("%d (%.1f%%)", n_g1, pct_g1),
G2_M_SD  = sprintf("%d (%.1f%%)", n_g2, pct_g2),
Statistic   = stat_str,
p           = p_val,
Effect_size = "",
stringsAsFactors = FALSE
)
}
# --- Construction du tableau ---
continuous_vars <- c("Age", "Education", "fNART_errors", "BDI_II", "MOCA")
table_rows <- bind_rows(
lapply(continuous_vars, function(v) build_row_continuous(stimuli_participants, v)),
build_row_categorical(stimuli_participants, "Gender")
)
# Renommer les colonnes avec les vrais noms de groupe
group_levels <- levels(stimuli_participants$Group)
colnames(table_rows) <- c(
"Variable",
paste0(group_levels[1], "\nM (SD)"),
paste0(group_levels[2], "\nM (SD)"),
"Statistic",
"p",
"Effect size"
)
# --- Tableau APA avec rempsyc::nice_table ---
apa_table <- nice_table(
table_rows,
title = c("Table 1",
"Comparison of Stimuli Participants by Group on Matching Variables"),
note  = c("M = mean; SD = standard deviation. For continuous variables, a Student's t-test, Welch's t-test, or Wilcoxon-Mann-Whitney test was used depending on normality and homogeneity of variance assumptions. For Gender, a chi-square test or Fisher's exact test was used depending on expected frequencies.",
"* p < .05, ** p < .01, *** p < .001.")
)
apa_table
# Charger les librairies
library(readxl)
library(writexl)
library(dplyr)
library(tidyr)
# Chemins des fichiers
features_path <- "C:/Users/factory/Desktop/pour master psycho/all_participants_features.csv"
result_path   <- "C:/Users/factory/Desktop/pour master psycho/result_1.xlsx"
output_path   <- "C:/Users/factory/Desktop/pour master psycho/result_1_with_qom.xlsx"
# Lire les fichiers
features <- read.csv(features_path, stringsAsFactors = FALSE)
result   <- read_excel(result_path)
# Corriger l'erreur : remplacer "Video_P9_PLD.mp4" par "Video_P9.mp4"
result <- result %>%
mutate(vid = ifelse(vid == "Video_P9_PLD.mp4", "Video_P9.mp4", vid))
# Garder les signaux "hands_horizontal" et "hands_vertical"
# et passer du format long au format large (une colonne par signal)
expansiveness_hands <- features %>%
filter(signal %in% c("hands_horizontal", "hands_vertical")) %>%
select(participant_id, signal, expansiveness) %>%
pivot_wider(
names_from  = signal,
values_from = expansiveness,
names_prefix = "expansiveness_"
)
# Extraire l'ID du participant depuis le nom de la vidéo
result <- result %>%
mutate(participant_id = sub("^Video_(.*)\\.mp4$", "\\1", vid))
# Joindre les deux tables
result <- result %>%
left_join(expansiveness_hands, by = "participant_id")
# Sauvegarder le nouveau fichier Excel
write_xlsx(result, output_path)
# Vérification rapide
head(result[, c("vid", "participant_id",
"expansiveness_hands_horizontal",
"expansiveness_hands_vertical")])
# Vérifier qu'il n'y a pas de NA inattendus
cat("NA dans expansiveness_hands_horizontal :",
sum(is.na(result$expansiveness_hands_horizontal)), "\n")
cat("NA dans expansiveness_hands_vertical :",
sum(is.na(result$expansiveness_hands_vertical)), "\n")
