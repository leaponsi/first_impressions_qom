)
### Set directory
DATA_PATH = file.path("data")
SOUR_PATH = file.path("sources")
NOTE_PATH = file.path("notebooks")
RESULTS_PATH = file.path("results")
### Open the file
PATH = file.path(DATA_PATH, "data_1st_imp.xlsx")
data = read_xlsx(PATH)
PATH_2 = file.path(DATA_PATH, "data_1st_imp_2.xlsx")
data_2 = read_xlsx(PATH_2)
### Remove the participants who did not pass the attention check
data <- data %>%
filter(AC03_01 > 90)
data_2 <- data_2 %>%
filter(AC03_01 > 90)
#################### Step 1 - organize questionnaire data ######################
### Result file
n_videos = 10
result_1st_imp = data.frame(matrix(ncol = 0, nrow = nrow(data) * n_videos))
result_1st_imp_2 = data.frame(matrix(ncol = 0, nrow = nrow(data_2) * n_videos))
# Descriptive
result_1st_imp$CASE = rep(data$CASE, each = n_videos)
result_1st_imp$Age = rep(data$DE03x01, each = n_videos)
result_1st_imp$Gender = rep(ifelse(data$DE08 == 1, "F", "H"), each = n_videos)
result_1st_imp$Pro_Sante = rep(data$DE12, each = n_videos)
result_1st_imp_2$CASE = rep(data_2$CASE, each = n_videos)
result_1st_imp_2$Age = rep(data_2$DE03x01, each = n_videos)
result_1st_imp_2$Gender = rep(ifelse(data_2$DE08 == 1, "F", "H"), each = n_videos)
result_1st_imp_2$Pro_Sante = rep(data_2$DE12, each = n_videos)
# Video
vid_cols = grep("VI03_", colnames(data))
result_1st_imp$vid = as.vector(t(data[, vid_cols]))
vid_cols_2 = grep("VI03_", colnames(data_2))
result_1st_imp_2$vid = as.vector(t(data_2[, vid_cols_2]))
# Num
result_1st_imp$num_video = rep(1:n_videos, times = nrow(data))
result_1st_imp_2$num_video = rep(1:n_videos, times = nrow(data_2))
# Type
result_1st_imp$Type = ifelse(
grepl("Video_P", result_1st_imp$vid),
"Healthy",
"Patient"
)
result_1st_imp_2$Type = ifelse(
grepl("Video_P", result_1st_imp_2$vid),
"Healthy",
"Patient"
)
# 1st imp
im_columns = list(
Sympathique = c("IM01_01", "IM07_01", "IM13_01", "IM19_01", "IM25_01", "IM31_01", "IM37_01", "IM43_01", "IM49_01", "IM55_01"),
Bizarre = c("IM02_01", "IM08_01", "IM14_01", "IM20_01", "IM26_01", "IM32_01", "IM38_01", "IM44_01", "IM50_01", "IM56_01"),
