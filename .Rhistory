p <- ggplot(result_1st_imp, aes(x = Type, y = Total_score, fill = Type)) +
stat_summary(fun = mean, geom = "bar", width = 0.6) +
stat_summary(
fun.data = mean_cl_boot,
geom = "errorbar",
width = 0.2
) +
stat_compare_means(
comparisons = list(c("Patient", "Healthy")),
method = "t.test",
label = "p.signif",
hide.ns = TRUE,
label.y = 600,
tip.length = 0.01,
symnum.args = list(
cutpoints = c(0, 0.001, 0.01, 0.05, 1),
symbols = c("***", "**", "*", "ns")
)
) +
theme_minimal() +
theme(
legend.position = "none",
axis.title.x = element_text(margin = margin(t = 8)),
axis.title.y = element_text(margin = margin(r = 8))
) +
labs(
x = "Type of Stimuli Participants",
y = "Total First Impression Score"
) +
scale_fill_manual(
values = c("Patient" = "steelblue", "Healthy" = "orange")
) +
scale_x_discrete(
labels = c("Patient" = "ISZ", "Healthy" = "HC")
)
p
